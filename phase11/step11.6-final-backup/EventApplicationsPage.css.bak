/* ============================================================
   ATHLETIQ APPLICATIONS
   2026 CANDIDATE COMMAND CENTER
   ============================================================ */


/* ============================================================
   PAGE FOUNDATION
   ============================================================ */

.applications-page {

    position:
        relative;

    width:
        100%;

    min-height:
        100vh;

    box-sizing:
        border-box;

    padding:
        28px
        clamp(14px, 4vw, 54px)
        65px;

    overflow-x:
        hidden;

    color:
        #e5eef8;

    background:
        radial-gradient(
            circle at 8% 7%,
            rgba(2,132,199,.18),
            transparent 25%
        ),
        radial-gradient(
            circle at 92% 76%,
            rgba(99,102,241,.18),
            transparent 30%
        ),
        radial-gradient(
            circle at 50% 39%,
            rgba(34,211,238,.045),
            transparent 27%
        ),
        linear-gradient(
            135deg,
            #030712 0%,
            #080a1d 47%,
            #0c0a27 73%,
            #030712 100%
        );

    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    isolation:
        isolate;

    animation:
        aq-applications-enter
        .5s
        cubic-bezier(.22,1,.36,1);
}

.applications-page::before {

    content:
        "";

    position:
        fixed;

    inset:
        0;

    z-index:
        -3;

    pointer-events:
        none;

    opacity:
        .18;

    background-image:
        linear-gradient(
            rgba(56,189,248,.11) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(56,189,248,.11) 1px,
            transparent 1px
        );

    background-size:
        48px 48px;

    mask-image:
        radial-gradient(
            ellipse 88% 78% at center,
            black 12%,
            transparent 90%
        );

    animation:
        aq-applications-grid
        26s
        linear
        infinite;
}


/* ============================================================
   HEADER
   ============================================================ */

.applications-header {

    position:
        relative;

    display:
        flex;

    align-items:
        flex-end;

    justify-content:
        space-between;

    gap:
        24px;

    width:
        min(1200px, 100%);

    margin:
        0 auto 14px;

    padding:
        32px 38px;

    box-sizing:
        border-box;

    overflow:
        hidden;

    border:
        1px solid
        rgba(103,232,249,.14);

    border-radius:
        24px;

    background:
        radial-gradient(
            circle at 88% 15%,
            rgba(34,211,238,.14),
            transparent 25%
        ),
        radial-gradient(
            circle at 95% 92%,
            rgba(99,102,241,.16),
            transparent 29%
        ),
        linear-gradient(
            125deg,
            rgba(9,16,37,.97),
            rgba(14,29,62,.94) 52%,
            rgba(31,23,67,.92)
        );

    box-shadow:
        0 26px 70px
        rgba(0,0,0,.34),
        inset
        0 1px 0
        rgba(255,255,255,.045);

    backdrop-filter:
        blur(18px);
}

.applications-header::before {

    content:
        "";

    position:
        absolute;

    inset:
        0;

    pointer-events:
        none;

    background:
        linear-gradient(
            115deg,
            transparent 15%,
            rgba(255,255,255,.035) 48%,
            transparent 68%
        );

    transform:
        translateX(-110%);

    animation:
        aq-applications-sweep
        8s
        ease-in-out
        infinite;
}

.applications-header::after {

    content:
        "";

    position:
        absolute;

    width:
        380px;

    height:
        380px;

    right:
        -180px;

    bottom:
        -225px;

    border-radius:
        50%;

    border:
        1px solid
        rgba(103,232,249,.09);

    box-shadow:
        0 0 0 42px
        rgba(34,211,238,.018),
        0 0 0 90px
        rgba(99,102,241,.014);

    pointer-events:
        none;

    animation:
        aq-applications-ring
        11s
        ease-in-out
        infinite;
}

.applications-header > div:first-child {

    position:
        relative;

    z-index:
        1;

    min-width:
        0;
}

.applications-back {

    min-height:
        32px;

    padding:
        0 10px;

    border:
        1px solid
        rgba(103,232,249,.13);

    border-radius:
        9px;

    background:
        rgba(255,255,255,.025);

    color:
        #67e8f9;

    font-size:
        8px;

    font-weight:
        900;

    cursor:
        pointer;

    transition:
        transform .16s ease,
        background .16s ease,
        border-color .16s ease;
}

.applications-back::before {

    content:
        "←";

    margin-right:
        6px;

    font-size:
        12px;
}

.applications-back:hover {

    transform:
        translateX(-2px);

    background:
        rgba(34,211,238,.06);

    border-color:
        rgba(103,232,249,.25);
}

.applications-eyebrow {

    display:
        block;

    margin-top:
        17px;

    color:
        #38bdf8;

    font-size:
        8px;

    font-weight:
        950;

    letter-spacing:
        .17em;
}

.applications-header h1 {

    margin:
        6px 0 7px;

    color:
        #ffffff;

    font-size:
        clamp(
            40px,
            5vw,
            64px
        );

    font-weight:
        950;

    line-height:
        .94;

    letter-spacing:
        -.065em;
}

.applications-header h1::after {

    content:
        "";

    display:
        block;

    width:
        68px;

    height:
        3px;

    margin-top:
        14px;

    border-radius:
        999px;

    background:
        linear-gradient(
            90deg,
            #22d3ee,
            #38bdf8,
            #8b5cf6
        );

    box-shadow:
        0 0 17px
        rgba(34,211,238,.30);
}

.applications-header p {

    margin:
        0;

    color:
        #94a3b8;

    font-size:
        11px;

    line-height:
        1.65;
}


/* ============================================================
   TOTAL APPLICATIONS
   ============================================================ */

.applications-header-total {

    position:
        relative;

    z-index:
        2;

    flex:
        0 0 auto;

    min-width:
        150px;

    padding:
        17px 20px;

    border:
        1px solid
        rgba(103,232,249,.16);

    border-radius:
        15px;

    background:
        rgba(255,255,255,.035);

    text-align:
        center;

    box-shadow:
        inset
        0 1px 0
        rgba(255,255,255,.03);
}

.applications-header-total strong {

    display:
        block;

    color:
        #ffffff;

    font-size:
        34px;

    font-weight:
        950;

    letter-spacing:
        -.055em;
}

.applications-header-total span {

    color:
        #64748b;

    font-size:
        7px;

    font-weight:
        950;

    letter-spacing:
        .10em;

    text-transform:
        uppercase;
}


/* ============================================================
   STATISTICS
   ============================================================ */

.applications-stats {

    width:
        min(1200px, 100%);

    margin:
        0 auto 13px;

    display:
        grid;

    grid-template-columns:
        repeat(
            6,
            minmax(0,1fr)
        );

    gap:
        8px;
}

.application-stat-card {

    position:
        relative;

    min-width:
        0;

    padding:
        14px;

    overflow:
        hidden;

    border:
        1px solid
        rgba(148,163,184,.10);

    border-radius:
        14px;

    background:
        linear-gradient(
            145deg,
            rgba(13,25,50,.88),
            rgba(7,13,29,.94)
        );

    box-shadow:
        0 11px 27px
        rgba(0,0,0,.17),
        inset
        0 1px 0
        rgba(255,255,255,.025);

    transition:
        transform .17s ease,
        border-color .17s ease,
        box-shadow .17s ease;
}

.application-stat-card::after {

    content:
        "";

    position:
        absolute;

    right:
        -30px;

    bottom:
        -35px;

    width:
        90px;

    height:
        90px;

    border-radius:
        50%;

    background:
        radial-gradient(
            circle,
            rgba(34,211,238,.06),
            transparent 70%
        );

    pointer-events:
        none;
}

.application-stat-card:hover {

    transform:
        translateY(-2px);

    border-color:
        rgba(103,232,249,.16);

    box-shadow:
        0 15px 32px
        rgba(0,0,0,.23);
}

.application-stat-card span {

    display:
        block;

    color:
        #64748b;

    font-size:
        7px;

    font-weight:
        950;

    letter-spacing:
        .10em;

    text-transform:
        uppercase;
}

.application-stat-card strong {

    display:
        block;

    margin-top:
        7px;

    color:
        #f8fafc;

    font-size:
        24px;

    font-weight:
        950;

    letter-spacing:
        -.045em;
}


/* ============================================================
   FILTER TOOLBAR
   ============================================================ */

.applications-toolbar {

    width:
        min(1200px, 100%);

    margin:
        0 auto 13px;

    padding:
        17px;

    box-sizing:
        border-box;

    border:
        1px solid
        rgba(148,163,184,.10);

    border-radius:
        16px;

    background:
        linear-gradient(
            145deg,
            rgba(13,25,50,.90),
            rgba(6,13,29,.96)
        );

    box-shadow:
        0 14px 34px
        rgba(0,0,0,.20),
        inset
        0 1px 0
        rgba(255,255,255,.025);

    backdrop-filter:
        blur(15px);
}

.application-filter-grid {

    display:
        grid;

    grid-template-columns:
        repeat(
            5,
            minmax(0,1fr)
        )
        auto;

    gap:
        8px;

    align-items:
        end;
}

.application-filter-grid label,
.application-sort-row label {

    display:
        grid;

    min-width:
        0;

    gap:
        6px;
}

.application-filter-grid label span,
.application-sort-row label span {

    color:
        #64748b;

    font-size:
        7px;

    font-weight:
        950;

    letter-spacing:
        .09em;

    text-transform:
        uppercase;
}

.application-filter-grid input,
.application-filter-grid select,
.application-sort-row select {

    width:
        100%;

    min-width:
        0;

    min-height:
        40px;

    box-sizing:
        border-box;

    padding:
        0 10px;

    border:
        1px solid
        rgba(148,163,184,.12);

    border-radius:
        9px;

    outline:
        none;

    background:
        rgba(2,6,23,.64);

    color:
        #e2e8f0;

    font-family:
        inherit;

    font-size:
        10px;

    color-scheme:
        dark;

    transition:
        border-color .17s ease,
        background .17s ease,
        box-shadow .17s ease;
}

.application-filter-grid input::placeholder {

    color:
        #475569;
}

.application-filter-grid input:hover,
.application-filter-grid select:hover,
.application-sort-row select:hover {

    border-color:
        rgba(148,163,184,.22);

    background:
        rgba(3,8,20,.78);
}

.application-filter-grid input:focus,
.application-filter-grid select:focus,
.application-sort-row select:focus {

    border-color:
        #38bdf8;

    background:
        rgba(2,6,23,.92);

    box-shadow:
        0 0 0 3px
        rgba(56,189,248,.09);
}

.application-filter-actions {

    display:
        flex;

    gap:
        6px;
}

.applications-primary-button,
.applications-secondary-button,
.applications-sort-button,
.application-view-button {

    min-height:
        40px;

    border-radius:
        9px;

    padding:
        0 11px;

    font-family:
        inherit;

    font-size:
        8px;

    font-weight:
        950;

    cursor:
        pointer;

    transition:
        transform .16s ease,
        background .16s ease,
        border-color .16s ease,
        box-shadow .16s ease;
}

.applications-primary-button {

    border:
        1px solid
        rgba(255,255,255,.14);

    background:
        linear-gradient(
            135deg,
            #0284c7,
            #0ea5e9 50%,
            #6366f1
        );

    color:
        #ffffff;

    box-shadow:
        0 9px 21px
        rgba(14,165,233,.19);
}

.applications-primary-button:hover {

    transform:
        translateY(-1px);

    box-shadow:
        0 12px 25px
        rgba(14,165,233,.29);
}

.applications-secondary-button,
.applications-sort-button {

    border:
        1px solid
        rgba(148,163,184,.12);

    background:
        rgba(255,255,255,.025);

    color:
        #94a3b8;
}

.applications-secondary-button:hover,
.applications-sort-button:hover {

    transform:
        translateY(-1px);

    border-color:
        rgba(103,232,249,.19);

    background:
        rgba(56,189,248,.05);

    color:
        #67e8f9;
}

.application-sort-row {

    display:
        flex;

    justify-content:
        flex-end;

    align-items:
        flex-end;

    gap:
        8px;

    margin-top:
        12px;

    padding-top:
        12px;

    border-top:
        1px solid
        rgba(148,163,184,.07);
}

.application-sort-row label {

    min-width:
        155px;
}


/* ============================================================
   TABLE
   ============================================================ */

.applications-table-card {

    position:
        relative;

    width:
        min(1200px, 100%);

    margin:
        0 auto;

    overflow:
        hidden;

    border:
        1px solid
        rgba(148,163,184,.11);

    border-radius:
        17px;

    background:
        linear-gradient(
            145deg,
            rgba(13,25,50,.92),
            rgba(6,13,29,.97)
        );

    box-shadow:
        0 19px 42px
        rgba(0,0,0,.25),
        inset
        0 1px 0
        rgba(255,255,255,.025);

    backdrop-filter:
        blur(15px);
}

.applications-table-wrapper {

    overflow-x:
        auto;

    scrollbar-width:
        thin;

    scrollbar-color:
        #1e6f9f
        transparent;
}

.applications-table-wrapper::-webkit-scrollbar {

    height:
        7px;
}

.applications-table-wrapper::-webkit-scrollbar-thumb {

    border-radius:
        999px;

    background:
        #1e6f9f;
}

.applications-table {

    width:
        100%;

    min-width:
        980px;

    border-collapse:
        collapse;
}

.applications-table th {

    padding:
        12px 13px;

    border-bottom:
        1px solid
        rgba(148,163,184,.09);

    background:
        rgba(255,255,255,.025);

    color:
        #64748b;

    font-size:
        7px;

    font-weight:
        950;

    text-align:
        left;

    text-transform:
        uppercase;

    letter-spacing:
        .08em;
}

.applications-table td {

    padding:
        13px;

    border-bottom:
        1px solid
        rgba(148,163,184,.055);

    color:
        #94a3b8;

    font-size:
        9px;

    vertical-align:
        middle;
}

.applications-table tbody tr {

    transition:
        background .15s ease;
}

.applications-table tbody tr:hover {

    background:
        rgba(56,189,248,.028);
}

.applications-table tbody tr:last-child td {

    border-bottom:
        0;
}


/* ============================================================
   PLAYER CELL
   ============================================================ */

.player-cell {

    display:
        grid;

    gap:
        4px;

    min-width:
        150px;
}

.player-cell strong {

    color:
        #e2e8f0;

    font-size:
        10px;

    font-weight:
        900;
}

.player-cell span {

    overflow:
        hidden;

    color:
        #475569;

    font-size:
        8px;

    text-overflow:
        ellipsis;

    white-space:
        nowrap;
}


/* ============================================================
   STATUS BADGES
   ============================================================ */

.application-status-badge {

    display:
        inline-flex;

    align-items:
        center;

    min-height:
        23px;

    padding:
        0 8px;

    border:
        1px solid
        rgba(148,163,184,.10);

    border-radius:
        999px;

    background:
        rgba(255,255,255,.025);

    color:
        #94a3b8;

    font-size:
        7px;

    font-weight:
        950;

    letter-spacing:
        .05em;

    text-transform:
        uppercase;
}

.application-status-submitted {

    background:
        rgba(14,165,233,.07);

    border-color:
        rgba(14,165,233,.16);

    color:
        #67e8f9;
}

.application-status-validated {

    background:
        rgba(34,197,94,.07);

    border-color:
        rgba(34,197,94,.15);

    color:
        #86efac;
}

.application-status-evaluation_pending {

    background:
        rgba(245,158,11,.07);

    border-color:
        rgba(245,158,11,.15);

    color:
        #fcd34d;
}


/* ============================================================
   VIEW BUTTON
   ============================================================ */

.application-view-button {

    min-height:
        32px;

    border:
        1px solid
        rgba(103,232,249,.14);

    background:
        rgba(14,165,233,.06);

    color:
        #67e8f9;
}

.application-view-button:hover {

    transform:
        translateY(-1px);

    border-color:
        rgba(103,232,249,.25);

    background:
        rgba(14,165,233,.11);

    box-shadow:
        0 7px 16px
        rgba(14,165,233,.09);
}


/* ============================================================
   PAGINATION
   ============================================================ */

.applications-pagination {

    display:
        flex;

    align-items:
        center;

    justify-content:
        space-between;

    gap:
        14px;

    padding:
        12px 14px;

    border-top:
        1px solid
        rgba(148,163,184,.07);
}

.applications-pagination-info {

    color:
        #475569;

    font-size:
        8px;
}

.applications-pagination-controls {

    display:
        flex;

    align-items:
        center;

    gap:
        7px;
}

.applications-pagination-controls button {

    min-height:
        34px;

    padding:
        0 10px;

    border:
        1px solid
        rgba(148,163,184,.11);

    border-radius:
        8px;

    background:
        rgba(255,255,255,.025);

    color:
        #94a3b8;

    font-size:
        8px;

    font-weight:
        900;

    cursor:
        pointer;
}

.applications-pagination-controls button:hover:not(:disabled) {

    border-color:
        rgba(103,232,249,.20);

    background:
        rgba(56,189,248,.05);

    color:
        #67e8f9;
}

.applications-pagination-controls button:disabled {

    opacity:
        .35;

    cursor:
        not-allowed;
}

.applications-pagination-controls span {

    color:
        #64748b;

    font-size:
        8px;

    white-space:
        nowrap;
}


/* ============================================================
   EMPTY / LOADING / ERROR
   ============================================================ */

.applications-empty,
.applications-state {

    width:
        min(
            700px,
            calc(100% - 32px)
        );

    margin:
        65px auto;

    padding:
        34px;

    box-sizing:
        border-box;

    text-align:
        center;

    border:
        1px dashed
        rgba(103,232,249,.14);

    border-radius:
        18px;

    background:
        rgba(255,255,255,.018);

    color:
        #64748b;

    box-shadow:
        0 15px 35px
        rgba(0,0,0,.16);
}

.applications-empty h2 {

    margin:
        0 0 8px;

    color:
        #e2e8f0;

    font-size:
        18px;

    font-weight:
        950;
}

.applications-empty p {

    margin:
        0;

    color:
        #475569;

    font-size:
        9px;

    line-height:
        1.6;
}

.applications-state-error,
.applications-inline-error {

    color:
        #fca5a5;
}

.applications-inline-error {

    width:
        min(1200px, 100%);

    margin:
        0 auto 11px;

    padding:
        11px 13px;

    box-sizing:
        border-box;

    border:
        1px solid
        rgba(248,113,113,.20);

    border-radius:
        10px;

    background:
        rgba(127,29,29,.14);

    font-size:
        9px;
}


/* ============================================================
   APPLICATION DETAIL MODAL
   ============================================================ */

.application-detail-backdrop {

    position:
        fixed;

    inset:
        0;

    z-index:
        1000;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    padding:
        20px;

    box-sizing:
        border-box;

    background:
        rgba(1,5,16,.72);

    backdrop-filter:
        blur(9px);

    animation:
        aq-application-modal-bg
        .18s
        ease;
}

.application-detail-modal {

    width:
        min(
            820px,
            100%
        );

    max-height:
        88vh;

    overflow:
        auto;

    border:
        1px solid
        rgba(103,232,249,.16);

    border-radius:
        20px;

    background:
        linear-gradient(
            145deg,
            #0c1830,
            #070d1d
        );

    box-shadow:
        0 30px 90px
        rgba(0,0,0,.65),
        0 0 40px
        rgba(14,165,233,.045);

    animation:
        aq-application-modal-in
        .22s
        cubic-bezier(.22,1,.36,1);
}

.application-detail-header {

    display:
        flex;

    align-items:
        flex-start;

    justify-content:
        space-between;

    gap:
        15px;

    padding:
        20px 22px;

    border-bottom:
        1px solid
        rgba(148,163,184,.08);
}

.application-detail-header > div > span {

    color:
        #38bdf8;

    font-size:
        7px;

    font-weight:
        950;

    letter-spacing:
        .13em;
}

.application-detail-header h2 {

    margin:
        5px 0 0;

    color:
        #f8fafc;

    font-size:
        21px;

    font-weight:
        950;

    letter-spacing:
        -.035em;
}

.application-detail-header button {

    width:
        34px;

    height:
        34px;

    min-height:
        34px;

    padding:
        0;

    border:
        1px solid
        rgba(148,163,184,.12);

    border-radius:
        50%;

    background:
        rgba(255,255,255,.025);

    color:
        #94a3b8;

    font-size:
        19px;

    cursor:
        pointer;

    box-shadow:
        none;

    transition:
        background .16s ease,
        border-color .16s ease,
        color .16s ease;
}

.application-detail-header button:hover {

    border-color:
        rgba(103,232,249,.22);

    background:
        rgba(34,211,238,.06);

    color:
        #67e8f9;
}

.application-detail-body {

    padding:
        20px 22px 25px;
}

.application-detail-grid {

    display:
        grid;

    grid-template-columns:
        repeat(
            2,
            minmax(0,1fr)
        );

    gap:
        8px;

    margin-bottom:
        20px;
}

.application-detail-grid > div {

    display:
        grid;

    gap:
        5px;

    min-width:
        0;

    padding:
        11px;

    border:
        1px solid
        rgba(148,163,184,.08);

    border-radius:
        10px;

    background:
        rgba(255,255,255,.018);
}

.application-detail-grid span {

    color:
        #475569;

    font-size:
        7px;

    font-weight:
        950;

    letter-spacing:
        .08em;

    text-transform:
        uppercase;
}

.application-detail-grid strong {

    overflow:
        hidden;

    color:
        #cbd5e1;

    font-size:
        9px;

    line-height:
        1.45;

    word-break:
        break-word;
}


/* ============================================================
   DETAIL SECTIONS
   ============================================================ */

.application-detail-body > section {

    margin-top:
        18px;

    padding-top:
        18px;

    border-top:
        1px solid
        rgba(148,163,184,.08);
}

.application-detail-body h3 {

    margin:
        0 0 10px;

    color:
        #e2e8f0;

    font-size:
        14px;

    font-weight:
        950;
}

.application-answer-list {

    display:
        grid;

    gap:
        7px;
}

.application-answer-item {

    display:
        grid;

    gap:
        5px;

    padding:
        11px;

    border:
        1px solid
        rgba(148,163,184,.08);

    border-radius:
        10px;

    background:
        rgba(255,255,255,.018);
}

.application-answer-item span {

    color:
        #475569;

    font-size:
        7px;

    font-weight:
        950;

    letter-spacing:
        .08em;

    text-transform:
        uppercase;
}

.application-answer-item strong {

    color:
        #cbd5e1;

    font-size:
        9px;

    line-height:
        1.55;

    white-space:
        pre-wrap;

    word-break:
        break-word;
}

.application-answer-empty {

    padding:
        14px;

    border:
        1px dashed
        rgba(103,232,249,.13);

    border-radius:
        10px;

    color:
        #64748b;

    font-size:
        9px;

    text-align:
        center;
}


/* ============================================================
   FILE METADATA
   ============================================================ */

.application-file-list {

    display:
        grid;

    gap:
        8px;
}

.application-file-card {

    display:
        flex;

    align-items:
        center;

    gap:
        10px;

    padding:
        12px;

    border:
        1px solid
        rgba(148,163,184,.08);

    border-radius:
        11px;

    background:
        rgba(255,255,255,.018);
}

.application-file-icon {

    width:
        34px;

    height:
        34px;

    display:
        grid;

    place-items:
        center;

    flex:
        0 0 auto;

    border:
        1px solid
        rgba(103,232,249,.10);

    border-radius:
        9px;

    background:
        rgba(34,211,238,.045);

    font-size:
        15px;
}

.application-file-main {

    min-width:
        0;

    flex:
        1;
}

.application-file-main strong {

    display:
        block;

    overflow:
        hidden;

    color:
        #e2e8f0;

    font-size:
        9px;

    text-overflow:
        ellipsis;

    white-space:
        nowrap;
}

.application-file-meta {

    display:
        flex;

    flex-wrap:
        wrap;

    gap:
        5px 10px;

    margin-top:
        5px;

    color:
        #475569;

    font-size:
        7px;
}

.application-file-key {

    display:
        inline-block;

    margin-top:
        6px;

    padding:
        4px 6px;

    border:
        1px solid
        rgba(148,163,184,.07);

    border-radius:
        6px;

    background:
        rgba(255,255,255,.02);

    color:
        #475569;

    font-size:
        6px;
}

.application-file-badge {

    flex:
        0 0 auto;

    padding:
        5px 7px;

    border:
        1px solid
        rgba(14,165,233,.13);

    border-radius:
        999px;

    background:
        rgba(14,165,233,.055);

    color:
        #67e8f9;

    font-size:
        6px;

    font-weight:
        950;

    text-transform:
        uppercase;
}

.application-file-empty {

    display:
        grid;

    gap:
        4px;

    padding:
        14px;

    border:
        1px dashed
        rgba(103,232,249,.13);

    border-radius:
        10px;

    background:
        rgba(255,255,255,.018);
}

.application-file-empty strong {

    color:
        #cbd5e1;

    font-size:
        9px;
}

.application-file-empty span {

    color:
        #475569;

    font-size:
        8px;
}

.application-file-note {

    margin:
        8px 0 0;

    color:
        #475569;

    font-size:
        7px;

    line-height:
        1.55;
}


/* ============================================================
   DETAIL STATE
   ============================================================ */

.application-detail-state {

    padding:
        40px 20px;

    text-align:
        center;

    color:
        #64748b;

    font-size:
        10px;
}

.application-detail-state-error {

    color:
        #fca5a5;
}


/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 1050px) {

    .applications-stats {

        grid-template-columns:
            repeat(
                3,
                minmax(0,1fr)
            );
    }

    .application-filter-grid {

        grid-template-columns:
            repeat(
                3,
                minmax(0,1fr)
            );

    }

    .application-filter-actions {

        grid-column:
            1 / -1;
    }
}

@media (max-width: 760px) {

    .applications-page {

        padding:
            18px
            10px
            42px;
    }

    .applications-header {

        align-items:
            flex-start;

        flex-direction:
            column;

        padding:
            25px 20px;
    }

    .applications-header h1 {

        font-size:
            39px;
    }

    .applications-header-total {

        width:
            100%;

        box-sizing:
            border-box;
    }

    .applications-stats {

        grid-template-columns:
            repeat(
                2,
                minmax(0,1fr)
            );
    }

    .application-filter-grid {

        grid-template-columns:
            1fr;
    }

    .application-filter-actions {

        grid-column:
            auto;

        display:
            grid;

        grid-template-columns:
            1fr 1fr;
    }

    .application-sort-row {

        align-items:
            stretch;

        flex-direction:
            column;
    }

    .application-sort-row label {

        min-width:
            0;

        width:
            100%;
    }

    .application-sort-row button {

        width:
            100%;
    }

    .applications-pagination {

        align-items:
            flex-start;

        flex-direction:
            column;
    }

    .applications-pagination-controls {

        width:
            100%;

        justify-content:
            space-between;
    }

    .application-detail-backdrop {

        padding:
            10px;
    }

    .application-detail-modal {

        max-height:
            92vh;

        border-radius:
            16px;
    }

    .application-detail-header {

        padding:
            17px;
    }

    .application-detail-body {

        padding:
            17px;
    }

    .application-detail-grid {

        grid-template-columns:
            1fr;
    }

    .application-file-card {

        align-items:
            flex-start;
    }

    .application-file-badge {

        display:
            none;
    }

    .application-file-meta {

        flex-direction:
            column;

        gap:
            3px;
    }
}


/* ============================================================
   ANIMATIONS
   ============================================================ */

@keyframes aq-applications-enter {

    from {
        opacity:
            0;

        transform:
            translateY(9px);
    }

    to {
        opacity:
            1;

        transform:
            translateY(0);
    }
}

@keyframes aq-applications-grid {

    from {
        background-position:
            0 0;
    }

    to {
        background-position:
            48px 48px;
    }
}

@keyframes aq-applications-sweep {

    0%,
    58% {
        transform:
            translateX(-110%);
    }

    82%,
    100% {
        transform:
            translateX(130%);
    }
}

@keyframes aq-applications-ring {

    0%,
    100% {
        transform:
            translate(
                0,
                0
            )
            scale(1);
    }

    50% {
        transform:
            translate(
                -10px,
                -10px
            )
            scale(1.04);
    }
}

@keyframes aq-application-modal-bg {

    from {
        opacity:
            0;
    }

    to {
        opacity:
            1;
    }
}

@keyframes aq-application-modal-in {

    from {
        opacity:
            0;

        transform:
            translateY(10px)
            scale(.985);
    }

    to {
        opacity:
            1;

        transform:
            translateY(0)
            scale(1);
    }
}


/* ============================================================
   REDUCED MOTION
   ============================================================ */

@media (prefers-reduced-motion: reduce) {

    .applications-page,
    .applications-page::before,
    .applications-header::before,
    .applications-header::after,
    .application-detail-backdrop,
    .application-detail-modal {

        animation:
            none !important;
    }

    .applications-page *,
    .applications-back,
    .application-stat-card,
    .applications-primary-button,
    .applications-secondary-button,
    .applications-sort-button,
    .application-view-button {

        transition:
            none !important;
    }
}
