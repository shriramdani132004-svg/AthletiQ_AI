# AthletiQ Environment Variables

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=athletiq
POSTGRES_USER=athletiq
POSTGRES_PASSWORD=change_me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Backend
BACKEND_PORT=8080

# AI Service
AI_SERVICE_URL=http://localhost:8000

# Frontend
FRONTEND_PORT=5173

# JWT
ATHLETIQ_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ATHLETIQ_JWT_EXPIRATION_MINUTES=30

# Authentication sessions
ATHLETIQ_REFRESH_TOKEN_DAYS=30

# Email
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com

# Public links
PUBLIC_BASE_URL=http://localhost:5173
ATHLETIQ_CORS_ALLOWED_ORIGINS=http://localhost:5173
