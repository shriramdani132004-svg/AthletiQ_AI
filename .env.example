# ==============================
# AthletiQ Environment Variables
# ==============================

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=athletiq
POSTGRES_USER=athletiq
POSTGRES_PASSWORD=change_me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Backend
BACKEND_PORT=8080

# AI Service
AI_SERVICE_URL=http://localhost:8000

# Frontend
FRONTEND_PORT=5173

# JWT
ATHLETIQ_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ATHLETIQ_JWT_EXPIRATION_MINUTES=30

# Authentication sessions
ATHLETIQ_REFRESH_TOKEN_DAYS=30
