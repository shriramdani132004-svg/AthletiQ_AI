    text-overflow:
        ellipsis;
}

.dashboard-event-meta {
    display:
        flex;

    flex-wrap:
        wrap;

    gap:
        5px 12px;
}

.dashboard-event-meta span {
    color:
        #7a90a5 !important;

    font-size:
        8px !important;
}

.dashboard-event-actions {
    display:
        flex !important;

    align-items:
        center !important;

    gap:
        6px !important;
}

.dashboard-outline-button,
.dashboard-primary-mini-button {
    min-height:
        32px !important;

    padding:
        0 10px !important;

    border-radius:
        9px !important;

    font-size:
        8px !important;

    font-weight:
        900 !important;

    cursor:
        pointer;

    transition:
        transform .16s ease,
        background .16s ease,
        border-color .16s ease !important;
}

.dashboard-outline-button {
    border:
        1px solid
        #d9e5f0 !important;

    background:
        #ffffff !important;

    color:
        #48617c !important;
}

.dashboard-outline-button:hover {
    transform:
        translateY(-1px);

    border-color:
        #a9d2e8 !important;

    color:
        #0284c7 !important;

    background:
        #f3faff !important;
}

.dashboard-primary-mini-button {
    border:
        1px solid
        #c7e6f5 !important;

    background:
        #edf8fe !important;

    color:
        #0277b5 !important;
}

.dashboard-primary-mini-button:hover {
    transform:
        translateY(-1px);

    background:
        #e2f4fd !important;

    border-color:
        #98cfe9 !important;
}

/* ============================================================
   STATUS BADGES
   ============================================================ */

.dashboard-status-badge {
    display:
        inline-flex !important;

    align-items:
        center !important;

    min-height:
        20px;

    padding:
        0 7px;

    border-radius:
        999px;

    font-size:
        7px !important;

    font-weight:
        950 !important;

    letter-spacing:
        .05em;
}

.dashboard-status-published,
.dashboard-status-applications-open {
    color:
        #047857 !important;

    background:
        #ecfdf5 !important;

    border:
        1px solid
        #c7eedc !important;
}

.dashboard-status-draft {
    color:
        #48617c !important;

    background:
        #f1f5f9 !important;

    border:
        1px solid
        #e2e8f0 !important;
}

.dashboard-status-applications-closed {
    color:
        #b45309 !important;

    background:
        #fff8e8 !important;

    border:
        1px solid
        #f7dfaa !important;
}

.dashboard-status-archived {
    color:
        #64748b !important;

    background:
        #f4f7fa !important;

    border:
        1px solid
        #e5eaf0 !important;
}

/* ============================================================
   ACTIVITY
   ============================================================ */

.dashboard-activity-list {
    display:
        grid !important;

    padding:
        8px !important;
}

.dashboard-activity-item {
    width:
        100%;

    display:
        grid !important;

    grid-template-columns:
        auto
        minmax(0,1fr)
        auto !important;

    align-items:
        center !important;

    gap:
        9px !important;

    padding:
        10px !important;

    border:
        0 !important;

    border-bottom:
        1px solid
        #edf2f6 !important;

    background:
        transparent !important;

    color:
        inherit;

    text-align:
        left;

    cursor:
        pointer;

    transition:
        background .16s ease,
        transform .16s ease !important;
}

.dashboard-activity-item:last-child {
    border-bottom:
        0 !important;
}

.dashboard-activity-item:hover {
    background:
        #f5fbff !important;

    transform:
        translateX(2px);
}

.dashboard-activity-number {
    width:
        28px !important;

    height:
        28px !important;

    display:
        grid !important;

    place-items:
        center !important;

    border:
        1px solid
        #d6ebf7 !important;

    border-radius:
        9px !important;

    background:
        #eff9fe !important;

    color:
        #0284c7 !important;

    font-size:
        8px !important;

    font-weight:
        950 !important;
}

.dashboard-activity-copy {
    min-width:
        0;

    display:
        flex;

    flex-direction:
        column;

    gap:
        2px;
}

.dashboard-activity-copy strong {
    overflow:
        hidden;

    color:
        #10233f !important;

    font-size:
        9px !important;

    font-weight:
        900 !important;

    text-overflow:
        ellipsis;

    white-space:
        nowrap;
}

.dashboard-activity-copy span {
    color:
        #7a90a5 !important;

    font-size:
        8px !important;
}

.dashboard-activity-item .dashboard-text-arrow {
    color:
        #9aabba !important;
}

/* ============================================================
   QUICK ACTIONS
   ============================================================ */

.dashboard-quick-grid {
    display:
        grid !important;

    grid-template-columns:
        repeat(
            2,
            minmax(0,1fr)
        ) !important;

    gap:
        8px !important;

    padding:
        11px !important;
}

.dashboard-quick-action {
    display:
        flex !important;

    align-items:
        flex-start !important;

    gap:
        9px !important;

    padding:
        11px !important;

    border:
        1px solid
        #e5edf4 !important;

    border-radius:
        12px !important;

    background:
        #fbfdff !important;

    color:
        #10233f !important;

    text-decoration:
        none !important;

    transition:
        transform .17s ease,
        border-color .17s ease,
        background .17s ease,
        box-shadow .17s ease !important;
}

.dashboard-quick-action:hover {
    transform:
        translateY(-2px) !important;

    border-color:
        #c3ddec !important;

    background:
        #f4faff !important;

    box-shadow:
        0 7px 18px
        rgba(7,26,51,.05);
}

.dashboard-quick-action > div {
    min-width:
        0;
}

.dashboard-quick-action strong {
    display:
        block;

    color:
        #10233f !important;

    font-size:
        9px !important;

    font-weight:
        900 !important;
}

.dashboard-quick-action div span {
    display:
        block;

    margin-top:
        3px;

    color:
        #7a90a5 !important;

    font-size:
        8px !important;

    line-height:
        1.4;
}

.quick-icon {
    width:
        31px !important;

    height:
        31px !important;

    flex:
        0 0 auto;

    display:
        grid !important;

    place-items:
        center !important;

    border-radius:
        9px !important;

    border:
        1px solid
        transparent !important;
}

.quick-icon.purple {
    background:
        #f2efff !important;

    color:
        #7457c7 !important;

    border-color:
        #ddd5fb !important;
}

.quick-icon.blue {
    background:
        #edf6ff !important;

    color:
        #3478c4 !important;

    border-color:
        #d3e7f8 !important;
}

.quick-icon.cyan {
    background:
        #e9fbfd !important;

    color:
        #0e91ad !important;

    border-color:
        #cceff3 !important;
}

.quick-icon.green {
    background:
        #ecfdf5 !important;

    color:
        #07916c !important;

    border-color:
        #ccefdc !important;
}

/* ============================================================
   STATES
   ============================================================ */

.dashboard-state-card {
    min-height:
        240px !important;

    display:
        flex !important;

    flex-direction:
        column !important;

    align-items:
        center !important;

    justify-content:
        center !important;

    gap:
        8px !important;

    padding:
        28px !important;

    color:
        #7a90a5 !important;

    text-align:
        center;
}

.dashboard-state-card strong {
    color:
        #48617c !important;

    font-size:
        12px !important;

    font-weight:
        900 !important;
}

.dashboard-state-card > span {
    color:
        #7a90a5 !important;

    font-size:
        9px !important;
}

.dashboard-error-state strong {
    color:
        #b91c1c !important;
}

.dashboard-error-state a {
    margin-top:
        5px;

    color:
        #0284c7 !important;

    font-size:
        9px !important;

    font-weight:
        900;

    text-decoration:
        none;
}

.dashboard-error-state a:hover {
    text-decoration:
        underline;
}

.dashboard-spinner {
    width:
        25px !important;

    height:
        25px !important;

    border:
        2px solid
        #dbeef8 !important;

    border-top-color:
        #0ea5e9 !important;

    border-right-color:
        #6366f1 !important;

    border-radius:
        50%;

    animation:
        aq-dashboard-spinner
        .75s
        linear
        infinite;
}

.dashboard-mini-empty {
    padding:
        24px !important;

    color:
        #91a4b7 !important;

    font-size:
        10px !important;

    text-align:
        center;
}

.dashboard-small-button {
    display:
        inline-flex !important;

    align-items:
        center !important;

    justify-content:
        center !important;

    gap:
        5px !important;

    min-height:
        34px !important;

    margin-top:
        7px !important;

    padding:
        0 11px !important;

    border:
        1px solid
        #c7e6f5 !important;

    border-radius:
        9px !important;

    background:
        #edf8fe !important;

    color:
        #0277b5 !important;

    font-size:
        8px !important;

    font-weight:
        900 !important;

    text-decoration:
        none !important;
}

.dashboard-small-button:hover {
    background:
        #e2f4fd !important;
}

/* ============================================================
   FOOTER
   ============================================================ */

.dashboard-footer {
    display:
        flex !important;

    align-items:
        center !important;

    justify-content:
        space-between !important;

    gap:
        14px;

    padding:
        20px 4px 4px !important;

    color:
        #91a4b7 !important;

    font-size:
        8px !important;
}

.dashboard-footer span:first-child {
    color:
        #48617c !important;

    font-weight:
        900 !important;
}

/* ============================================================
   SAFE PAGE ANIMATION
   ============================================================ */

.dashboard-page {
    animation:
        aq-dashboard-enter
        .35s
        cubic-bezier(.22,1,.36,1);
}

@keyframes aq-dashboard-enter {

    from {
        opacity:
            0;

        transform:
            translateY(6px);
    }

    to {
        opacity:
            1;

        transform:
            translateY(0);
    }
}

@keyframes aq-dashboard-spinner {

    to {
        transform:
            rotate(360deg);
    }
}

/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 1200px) {

    .dashboard-hero {
        padding:
            36px 38px !important;
    }

    .dashboard-hero-orbit {
        width:
            220px !important;

        height:
            220px !important;
    }

    .dashboard-main-grid {
        grid-template-columns:
            1fr !important;
    }
}

@media (max-width: 900px) {

    .dashboard-page {
        width:
            calc(100% - 28px) !important;

        padding-top:
            20px !important;
    }

    .dashboard-stats-grid {
        grid-template-columns:
            repeat(
                2,
                minmax(0,1fr)
            ) !important;
    }

    .dashboard-hero {
        min-height:
            auto !important;

        padding:
            30px !important;
    }

    .dashboard-hero-orbit {
        display:
            none !important;
    }
}

@media (max-width: 640px) {

    .dashboard-page {
        width:
            calc(100% - 16px) !important;

        padding:
            16px 0
            30px !important;
    }

    .dashboard-hero {
        border-radius:
            18px !important;

        padding:
            25px 20px !important;
    }

    .dashboard-hero h1 {
        font-size:
            37px !important;
    }

    .dashboard-hero p {
        font-size:
            12px !important;
    }

    .dashboard-hero-actions {
        display:
            grid !important;

        grid-template-columns:
            1fr !important;
    }

    .dashboard-primary-button,
    .dashboard-secondary-button {
        width:
            100% !important;
    }

    .dashboard-stats-grid {
        grid-template-columns:
            1fr !important;
    }

    .dashboard-event-card {
        grid-template-columns:
            auto
            minmax(0,1fr) !important;
    }

    .dashboard-event-actions {
        grid-column:
            1 / -1 !important;

        width:
            100% !important;
    }

    .dashboard-event-actions button {
        flex:
            1 !important;
    }

    .dashboard-quick-grid {
        grid-template-columns:
            1fr !important;
    }

    .dashboard-footer {
        flex-direction:
            column !important;

        align-items:
            flex-start !important;
    }
}

@media (prefers-reduced-motion: reduce) {

    .dashboard-page,
    .dashboard-spinner {
        animation:
            none !important;
    }

    .dashboard-stat-card,
    .dashboard-event-card,
    .dashboard-quick-action,
    .dashboard-primary-button,
    .dashboard-secondary-button,
    .dashboard-outline-button,
    .dashboard-primary-mini-button {
        transition:
            none !important;
    }
}
