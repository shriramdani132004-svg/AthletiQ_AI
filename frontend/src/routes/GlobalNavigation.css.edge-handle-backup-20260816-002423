.aq-global-navigation {
    position: fixed;
    top: 16px;
    right: 18px;
    z-index: 99999;
    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
}

.aq-global-navigation-trigger {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 14px;
    background:
        linear-gradient(
            145deg,
            #071a33,
            #0b2d52
        );
    color: #ffffff;
    box-shadow:
        0 12px 30px rgba(7,26,51,0.24);
    cursor: pointer;
    transition:
        transform 160ms ease,
        box-shadow 160ms ease,
        background 160ms ease;
}

.aq-global-navigation-trigger:hover {
    transform: translateY(-1px);
    box-shadow:
        0 16px 34px rgba(7,26,51,0.3);
}

.aq-global-navigation-trigger.is-open {
    background:
        linear-gradient(
            145deg,
            #0b2d52,
            #0e7490
        );
}

.aq-global-navigation-trigger span {
    display: block;
    margin-top: -7px;
    font-size: 34px;
    line-height: 1;
    font-weight: 900;
}

.aq-global-navigation-panel {
    position: absolute;
    top: 56px;
    right: 0;
    width: min(360px, calc(100vw - 24px));
    max-height: min(78vh, 720px);
    overflow-y: auto;
    padding: 18px;
    border: 1px solid #dce4ee;
    border-radius: 20px;
    background: rgba(255,255,255,0.98);
    box-shadow:
        0 24px 60px rgba(15,23,42,0.18);
    backdrop-filter: blur(18px);
}

.aq-global-navigation-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 16px;
    border-bottom: 1px solid #edf2f7;
}

.aq-global-navigation-eyebrow {
    display: block;
    margin-bottom: 5px;
    color: #0284c7;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .12em;
}

.aq-global-navigation-header h2 {
    margin: 0;
    color: #071a33;
    font-size: 20px;
    line-height: 1.2;
}

.aq-global-navigation-header p {
    margin: 7px 0 0;
    color: #667085;
    font-size: 11px;
    line-height: 1.55;
}

.aq-global-navigation-close {
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    border: 1px solid #e4e7ec;
    border-radius: 10px;
    background: #f8fafc;
    color: #344054;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
}

.aq-global-navigation-section {
    padding-top: 16px;
}

.aq-global-navigation-section-title {
    margin-bottom: 9px;
    color: #667085;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .1em;
}

.aq-global-navigation-list {
    display: grid;
    gap: 6px;
}

.aq-global-navigation-item {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #edf2f7;
    border-radius: 12px;
    background: #ffffff;
    text-align: left;
    cursor: pointer;
    transition:
        background 140ms ease,
        border-color 140ms ease,
        transform 140ms ease;
}

.aq-global-navigation-item:hover {
    transform: translateY(-1px);
    border-color: #cbd5e1;
    background: #f8fafc;
}

.aq-global-navigation-item.active {
    border-color: #7dd3fc;
    background: #f0f9ff;
}

.aq-global-navigation-item-title {
    display: block;
    color: #0f172a;
    font-size: 12px;
    font-weight: 850;
}

.aq-global-navigation-item-description {
    display: block;
    margin-top: 2px;
    color: #667085;
    font-size: 10px;
}

.aq-global-navigation-input-row {
    display: flex;
    gap: 7px;
}

.aq-global-navigation-input-row input {
    min-width: 0;
    flex: 1;
    height: 40px;
    box-sizing: border-box;
    padding: 0 11px;
    border: 1px solid #d0d5dd;
    border-radius: 10px;
    background: #ffffff;
    color: #101828;
    outline: none;
}

.aq-global-navigation-input-row input:focus {
    border-color: #0ea5e9;
    box-shadow:
        0 0 0 3px rgba(14,165,233,0.12);
}

.aq-global-navigation-input-row > button {
    flex: 0 0 auto;
    height: 40px;
    padding: 0 13px;
    border: 0;
    border-radius: 10px;
    background: #0b2d52;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    cursor: pointer;
}

.aq-global-navigation-input-row > button:disabled,
.aq-global-navigation-grid button:disabled {
    opacity: .42;
    cursor: not-allowed;
}

.aq-global-navigation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 7px;
    margin-top: 8px;
}

.aq-global-navigation-grid button {
    min-height: 38px;
    padding: 7px 8px;
    border: 1px solid #dbe3ec;
    border-radius: 9px;
    background: #f8fafc;
    color: #344054;
    font-size: 10px;
    font-weight: 800;
    cursor: pointer;
}

.aq-global-navigation-grid button:not(:disabled):hover {
    border-color: #93c5fd;
    background: #eff6ff;
}

.aq-global-navigation-footer {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-top: 16px;
    padding-top: 13px;
    border-top: 1px solid #edf2f7;
}

.aq-global-navigation-footer span {
    color: #98a2b3;
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
}

.aq-global-navigation-footer strong {
    overflow: hidden;
    color: #475467;
    font-size: 10px;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
}

@media (max-width: 640px) {

    .aq-global-navigation {
        top: 10px;
        right: 10px;
    }

    .aq-global-navigation-trigger {
        width: 42px;
        height: 42px;
        border-radius: 12px;
    }

    .aq-global-navigation-panel {
        top: 50px;
        width: min(
            350px,
            calc(100vw - 20px)
        );
        max-height: 82vh;
        padding: 14px;
        border-radius: 16px;
    }
}
