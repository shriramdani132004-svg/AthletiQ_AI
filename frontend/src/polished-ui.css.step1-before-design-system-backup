/* ============================================================
   ATHLETIQ DESIGN SYSTEM
   Global visual layer
   ============================================================ */

:root {
    --aq-primary: #5b5cf0;
    --aq-primary-dark: #4748d8;
    --aq-primary-soft: #eef0ff;
    --aq-indigo: #6366f1;
    --aq-blue: #3b82f6;

    --aq-success: #12b76a;
    --aq-success-soft: #ecfdf3;
    --aq-warning: #f79009;
    --aq-warning-soft: #fffaeb;
    --aq-danger: #f04438;
    --aq-danger-soft: #fef3f2;

    --aq-bg: #f6f7fb;
    --aq-surface: #ffffff;
    --aq-surface-soft: #fafbff;

    --aq-text: #101828;
    --aq-text-secondary: #344054;
    --aq-muted: #667085;
    --aq-subtle: #98a2b3;

    --aq-border: #e4e7ec;
    --aq-border-dark: #d0d5dd;

    --aq-radius-sm: 8px;
    --aq-radius-md: 12px;
    --aq-radius-lg: 16px;
    --aq-radius-xl: 22px;

    --aq-shadow-sm:
        0 1px 3px rgba(16,24,40,.06),
        0 1px 2px rgba(16,24,40,.04);

    --aq-shadow-md:
        0 8px 24px rgba(16,24,40,.07),
        0 2px 6px rgba(16,24,40,.04);

    --aq-shadow-lg:
        0 20px 50px rgba(16,24,40,.09),
        0 6px 18px rgba(16,24,40,.05);

    --aq-transition:
        160ms cubic-bezier(.2,.8,.2,1);

    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
}

/* ============================================================
   BASE
   ============================================================ */

*,
*::before,
*::after {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    min-width: 320px;
    min-height: 100vh;
    color: var(--aq-text);
    background:
        radial-gradient(
            circle at 0% 0%,
            rgba(99,102,241,.07),
            transparent 26%
        ),
        radial-gradient(
            circle at 100% 0%,
            rgba(59,130,246,.06),
            transparent 24%
        ),
        var(--aq-bg);
    font-family: inherit;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
}

button,
input,
textarea,
select {
    font: inherit;
}

button {
    cursor: pointer;
}

button:disabled {
    cursor: not-allowed;
}

/* ============================================================
   GLOBAL PAGE CONTAINER
   ============================================================ */

main {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 36px 0 56px;
}

main > h1 {
    margin: 0 0 10px;
    color: var(--aq-text);
    font-size: clamp(28px, 4vw, 38px);
    line-height: 1.12;
    letter-spacing: -.035em;
    font-weight: 800;
}

main > p {
    color: var(--aq-muted);
    line-height: 1.65;
}

/* ============================================================
   GLOBAL CARD
   ============================================================ */

section,
article {
    border-radius: var(--aq-radius-lg);
}

main section {
    background: rgba(255,255,255,.92);
    border: 1px solid rgba(208,213,221,.72);
    box-shadow: var(--aq-shadow-sm);
}

/* ============================================================
   BUTTON SYSTEM
   ============================================================ */

button {
    min-height: 42px;
    padding: 10px 15px;
    border: 1px solid transparent;
    border-radius: var(--aq-radius-md);
    font-size: 14px;
    font-weight: 700;
    color: var(--aq-text-secondary);
    background: #fff;
    transition:
        transform var(--aq-transition),
        box-shadow var(--aq-transition),
        border-color var(--aq-transition),
        background var(--aq-transition),
        opacity var(--aq-transition);
}

button:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: var(--aq-shadow-md);
}

button:active:not(:disabled) {
    transform: translateY(0);
}

button:focus-visible {
    outline: none;
    box-shadow:
        0 0 0 4px rgba(91,92,240,.14),
        var(--aq-shadow-sm);
}

button[type="submit"],
button.primary,
.primary-button {
    color: #fff;
    background: linear-gradient(
        135deg,
        var(--aq-primary),
        var(--aq-indigo)
    );
    border-color: transparent;
}

button[type="submit"]:hover:not(:disabled),
button.primary:hover:not(:disabled),
.primary-button:hover:not(:disabled) {
    background: linear-gradient(
        135deg,
        var(--aq-primary-dark),
        #5558df
    );
}

button.secondary,
.secondary-button {
    background: #fff;
    color: var(--aq-text-secondary);
    border-color: var(--aq-border-dark);
}

button.danger,
.danger-button {
    color: #b42318;
    background: var(--aq-danger-soft);
    border-color: #fecdca;
}

/* ============================================================
   FORM CONTROLS
   ============================================================ */

label {
    color: var(--aq-text-secondary);
    font-size: 13px;
    font-weight: 700;
}

input,
select,
textarea {
    width: 100%;
    min-height: 44px;
    padding: 11px 13px;
    margin-top: 7px;
    color: var(--aq-text);
    background: #fff;
    border: 1px solid var(--aq-border-dark);
    border-radius: var(--aq-radius-md);
    outline: none;
    transition:
        border-color var(--aq-transition),
        box-shadow var(--aq-transition),
        background var(--aq-transition);
}

textarea {
    min-height: 112px;
    resize: vertical;
}

input::placeholder,
textarea::placeholder {
    color: var(--aq-subtle);
}

input:hover,
select:hover,
textarea:hover {
    border-color: #b7bfcc;
}

input:focus,
select:focus,
textarea:focus {
    border-color: var(--aq-primary);
    box-shadow: 0 0 0 4px rgba(91,92,240,.10);
}

/* ============================================================
   LOGIN + REGISTER
   ============================================================ */

main:has(form input[type="password"]) {
    min-height: calc(100vh - 70px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 480px;
}

main:has(form input[type="password"]) > h1 {
    margin-bottom: 8px;
    text-align: center;
}

main:has(form input[type="password"]) > form {
    margin-top: 22px;
    padding: 30px;
    background: rgba(255,255,255,.94);
    border: 1px solid var(--aq-border);
    border-radius: var(--aq-radius-xl);
    box-shadow: var(--aq-shadow-lg);
    backdrop-filter: blur(12px);
}

main:has(form input[type="password"]) > form label {
    display: block;
    margin-bottom: 18px;
}

main:has(form input[type="password"]) > form button {
    width: 100%;
    margin-top: 6px;
}

main:has(form input[type="password"]) [role="alert"] {
    padding: 12px 14px;
    margin: 5px 0 16px;
    border-radius: var(--aq-radius-md);
    color: #b42318;
    background: var(--aq-danger-soft);
    border: 1px solid #fecdca;
    font-size: 13px;
    font-weight: 700;
}

/* ============================================================
   DASHBOARD
   ============================================================ */

main:not(.profile-page):not(.event-form):not(.event-details-page):not(.form-builder-page) > h1 {
    margin-bottom: 18px;
}

main:not(.profile-page):not(.event-form):not(.event-details-page):not(.form-builder-page) > section {
    margin-top: 24px;
    padding: 24px;
}

main:not(.profile-page):not(.event-form):not(.event-details-page):not(.form-builder-page) > section p {
    margin: 8px 0;
}

main:not(.profile-page):not(.event-form):not(.event-details-page):not(.form-builder-page) > button {
    margin-top: 18px;
}

/* ============================================================
   PROFILE
   ============================================================ */

.profile-page {
    max-width: 1050px !important;
}

.profile-page > h1 {
    margin-bottom: 26px;
}

.profile-page section {
    padding: 24px;
    margin-bottom: 18px;
}

.profile-page section h2 {
    margin: 0 0 18px;
    font-size: 18px;
    letter-spacing: -.02em;
}

.profile-page form {
    display: grid;
    gap: 14px;
}

.profile-page form button {
    width: fit-content;
    min-width: 140px;
}

.profile-page section:nth-of-type(1) form {
    grid-template-columns: repeat(2, minmax(0,1fr));
}

.profile-page section:nth-of-type(1) form button {
    grid-column: 1 / -1;
}

.profile-page section:nth-of-type(2) form,
.profile-page section:nth-of-type(3) form {
    max-width: 680px;
}

.profile-page section:nth-of-type(3) label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
}

.profile-page section:nth-of-type(3) input[type="checkbox"] {
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--aq-primary);
}

.profile-page > p {
    padding: 12px 14px;
    border-radius: var(--aq-radius-md);
    background: var(--aq-success-soft);
    color: var(--aq-success);
    font-weight: 700;
}

/* ============================================================
   EVENT FORM
   ============================================================ */

.event-form {
    max-width: 1000px !important;
}

.event-form header {
    margin-bottom: 22px;
}

.event-form header h1 {
    margin: 0;
    font-size: 34px;
    font-weight: 800;
    letter-spacing: -.035em;
}

.event-form header p {
    margin-top: 8px;
    color: var(--aq-muted);
}

.event-form form {
    display: grid;
    gap: 18px;
    padding: 28px;
    background: rgba(255,255,255,.94);
    border: 1px solid var(--aq-border);
    border-radius: var(--aq-radius-xl);
    box-shadow: var(--aq-shadow-lg);
}

.event-form-grid {
    display: grid;
    grid-template-columns: repeat(2,minmax(0,1fr));
    gap: 16px;
}

.event-form-grid label,
.event-form form > label {
    display: block;
}

.event-form-error {
    margin-bottom: 18px;
    padding: 13px 15px;
    color: #b42318;
    background: var(--aq-danger-soft);
    border: 1px solid #fecdca;
    border-radius: var(--aq-radius-md);
    font-weight: 700;
}

.event-form-message {
    margin-bottom: 18px;
    padding: 13px 15px;
    color: var(--aq-success);
    background: var(--aq-success-soft);
    border: 1px solid #abefc6;
    border-radius: var(--aq-radius-md);
    font-weight: 700;
}

/* ============================================================
   EVENT DETAILS
   ============================================================ */

.event-details-page {
    max-width: 1100px !important;
}

.event-details-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 20px;
}

.event-details-header button {
    margin-bottom: 12px;
}

.event-details-header h1 {
    margin: 0;
    font-size: 38px;
    letter-spacing: -.04em;
    font-weight: 800;
}

.event-details-header p {
    margin: 8px 0 0;
    color: var(--aq-muted);
    font-weight: 600;
}

.event-details-status {
    display: inline-flex;
    align-items: center;
    padding: 7px 11px;
    border-radius: 999px;
    color: #3730a3;
    background: var(--aq-primary-soft);
    border: 1px solid #c7d2fe;
    font-size: 12px;
    font-weight: 800;
    white-space: nowrap;
}

.event-details-card {
    padding: 24px !important;
    margin-bottom: 18px;
}

.event-details-card h2 {
    margin: 0 0 16px;
    font-size: 18px;
    font-weight: 800;
}

.event-details-grid {
    display: grid !important;
    grid-template-columns: repeat(3,minmax(0,1fr));
    gap: 14px;
}

.event-details-grid > div {
    padding: 16px;
    background: var(--aq-surface-soft);
    border: 1px solid var(--aq-border);
    border-radius: var(--aq-radius-md);
}

.event-details-grid strong {
    display: block;
    margin-bottom: 6px;
    color: var(--aq-muted);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .05em;
}

.event-details-grid span {
    color: var(--aq-text);
    font-weight: 700;
}

.event-details-actions {
    display: flex !important;
    gap: 10px;
    flex-wrap: wrap;
}

.event-details-actions button {
    min-width: 130px;
}

.event-details-message,
.event-details-error {
    margin-bottom: 18px;
    padding: 13px 15px;
    border-radius: var(--aq-radius-md);
    font-weight: 700;
}

.event-details-message {
    color: var(--aq-success);
    background: var(--aq-success-soft);
    border: 1px solid #abefc6;
}

.event-details-error {
    color: #b42318;
    background: var(--aq-danger-soft);
    border: 1px solid #fecdca;
}

.event-banner {
    width: 100%;
    max-height: 380px;
    object-fit: cover;
    border-radius: var(--aq-radius-lg);
    border: 1px solid var(--aq-border);
}

/* ============================================================
   FORM BUILDER
   ============================================================ */

.form-builder-page {
    max-width: 1280px !important;
}

.form-builder-header {
    padding: 26px;
    margin-bottom: 20px;
    background: rgba(255,255,255,.94);
    border: 1px solid var(--aq-border);
    border-radius: var(--aq-radius-xl);
    box-shadow: var(--aq-shadow-md);
}

.form-builder-header h1 {
    margin: 0;
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -.035em;
}

.form-builder-header p {
    margin: 8px 0 0;
    color: var(--aq-muted);
}

.form-builder-page section {
    padding: 22px;
    margin-bottom: 18px;
}

.form-builder-page section h2 {
    margin: 0 0 15px;
    font-size: 17px;
    font-weight: 800;
}

.form-builder-page article {
    padding: 16px;
    margin-top: 12px;
    background: #fff;
    border: 1px solid var(--aq-border);
    box-shadow: var(--aq-shadow-sm);
    transition:
        transform var(--aq-transition),
        box-shadow var(--aq-transition),
        border-color var(--aq-transition);
}

.form-builder-page article:hover {
    transform: translateY(-1px);
    border-color: #c7d2fe;
    box-shadow: var(--aq-shadow-md);
}

.form-builder-page section:nth-of-type(4) {
    background: linear-gradient(
        180deg,
        #fff,
        #fafbff
    );
}

.form-builder-page section:nth-of-type(4) > div {
    display: grid;
    gap: 14px;
}

.form-builder-page section:nth-of-type(4) label {
    display: block;
}

.form-builder-page section:nth-of-type(4) button {
    margin-right: 8px;
}

.form-builder-page section:nth-of-type(4) button:first-of-type {
    color: #fff;
    background: linear-gradient(
        135deg,
        var(--aq-primary),
        var(--aq-indigo)
    );
}

.form-builder-page section:nth-of-type(4) button:last-of-type {
    background: #fff;
    border-color: var(--aq-border-dark);
}

/* ============================================================
   TABLE / LIST TREATMENT
   ============================================================ */

table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--aq-border);
    border-radius: var(--aq-radius-lg);
    box-shadow: var(--aq-shadow-sm);
}

th {
    padding: 13px 15px;
    text-align: left;
    color: var(--aq-muted);
    background: var(--aq-surface-soft);
    border-bottom: 1px solid var(--aq-border);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .04em;
}

td {
    padding: 15px;
    border-bottom: 1px solid var(--aq-border);
}

tr:last-child td {
    border-bottom: 0;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 900px) {
    main {
        width: min(100% - 28px, 760px);
        padding-top: 24px;
    }

    .event-details-grid {
        grid-template-columns: repeat(2,minmax(0,1fr));
    }

    .profile-page section:nth-of-type(1) form,
    .event-form-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 620px) {
    main {
        width: min(100% - 20px, 100%);
        padding-top: 18px;
        padding-bottom: 40px;
    }

    main:has(form input[type="password"]) > form {
        padding: 22px;
    }

    .event-details-header {
        flex-direction: column;
    }

    .event-details-header h1 {
        font-size: 30px;
    }

    .event-details-grid {
        grid-template-columns: 1fr;
    }

    .event-form form,
    .form-builder-header,
    .form-builder-page section,
    .profile-page section {
        padding: 18px;
    }
}