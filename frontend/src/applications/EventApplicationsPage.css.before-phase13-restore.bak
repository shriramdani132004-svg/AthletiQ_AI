/* ============================================================
   ATHLETIQ APPLICATIONS PAGE
   PART 1 — PAGE SHELL AND FOUNDATION
   ============================================================ */

.applications-page {
    min-height: 100vh;
    width: 100%;
    padding: 28px 32px 64px;
    color: #e8f0ff;
    background:
        radial-gradient(
            circle at 10% 0%,
            rgba(43, 126, 255, 0.2),
            transparent 34%
        ),
        radial-gradient(
            circle at 90% 10%,
            rgba(100, 70, 230, 0.2),
            transparent 36%
        ),
        #061329;
    box-sizing: border-box;
}

.applications-page *,
.applications-page *::before,
.applications-page *::after {
    box-sizing: border-box;
}

.applications-page button,
.applications-page input,
.applications-page select {
    font: inherit;
}

.applications-page button {
    cursor: pointer;
}

.applications-page button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
}

.applications-page a {
    color: inherit;
    text-decoration: none;
}

.applications-page h1,
.applications-page h2,
.applications-page h3,
.applications-page p {
    margin: 0;
}

.applications-page section {
    width: 100%;
}

.applications-page .applications-container {
    width: min(100%, 1580px);
    margin: 0 auto;
}

.applications-page .applications-card {
    border: 1px solid rgba(119, 183, 255, 0.2);
    border-radius: 22px;
    background: rgba(13, 29, 58, 0.92);
    box-shadow:
        0 20px 55px rgba(0, 0, 0, 0.24),
        inset 0 1px 0 rgba(255, 255, 255, 0.04);
}

.applications-page .applications-muted {
    color: #91a5c5;
}

.applications-page .applications-accent {
    color: #5ee7ff;
}

.applications-page .applications-divider {
    height: 1px;
    width: 100%;
    background: rgba(143, 181, 231, 0.16);
}

@media (max-width: 900px) {
    .applications-page {
        padding: 20px 18px 48px;
    }
}

@media (max-width: 560px) {
    .applications-page {
        padding: 16px 12px 40px;
    }

    .applications-page .applications-card {
        border-radius: 16px;
    }
}
/* ============================================================
   PART 2 — HEADER AND STATISTICS
   ============================================================ */

.applications-page .applications-hero {
    position: relative;
    overflow: hidden;
    margin-bottom: 24px;
    padding: 34px 40px;
    border: 1px solid rgba(96, 210, 255, 0.24);
    border-radius: 28px;
    background:
        linear-gradient(
            120deg,
            rgba(11, 31, 67, 0.98),
            rgba(38, 39, 102, 0.96)
        );
    box-shadow: 0 22px 60px rgba(0, 0, 0, 0.28);
}

.applications-page .applications-hero::after {
    content: "";
    position: absolute;
    right: -120px;
    top: -150px;
    width: 420px;
    height: 420px;
    border: 1px solid rgba(120, 194, 255, 0.16);
    border-radius: 50%;
    box-shadow:
        0 0 0 70px rgba(120, 194, 255, 0.04),
        0 0 0 140px rgba(120, 194, 255, 0.025);
    pointer-events: none;
}

.applications-page .applications-eyebrow {
    display: block;
    margin-bottom: 10px;
    color: #5ee7ff;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.16em;
}

.applications-page .applications-hero h1 {
    position: relative;
    z-index: 1;
    color: #ffffff;
    font-size: clamp(2.8rem, 6vw, 5.8rem);
    font-weight: 900;
    letter-spacing: -0.07em;
    line-height: 0.95;
}

.applications-page .applications-hero p {
    position: relative;
    z-index: 1;
    max-width: 620px;
    margin-top: 18px;
    color: #a8bad8;
    font-size: 1rem;
    line-height: 1.55;
}

.applications-page .applications-hero-total {
    position: absolute;
    z-index: 2;
    right: 38px;
    bottom: 32px;
    min-width: 170px;
    padding: 18px 22px;
    border: 1px solid rgba(112, 216, 255, 0.26);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.06);
    text-align: center;
}

.applications-page .applications-hero-total strong {
    display: block;
    color: #ffffff;
    font-size: 2.8rem;
    line-height: 1;
}

.applications-page .applications-hero-total span {
    display: block;
    margin-top: 8px;
    color: #8195b8;
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.applications-page .applications-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 24px;
    padding: 18px;
    border-radius: 22px;
    background: rgba(236, 240, 247, 0.96);
}

.applications-page .application-stat-card {
    min-height: 132px;
    padding: 24px 18px;
    border: 1px solid rgba(131, 164, 211, 0.2);
    border-radius: 18px;
    background: linear-gradient(
        145deg,
        #1d2b49,
        #142239
    );
    box-shadow: 0 14px 25px rgba(0, 0, 0, 0.16);
    text-align: center;
}

.applications-page .application-stat-card span {
    display: block;
    color: #8498b9;
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

.applications-page .application-stat-card strong {
    display: block;
    margin-top: 18px;
    color: #f5f8ff;
    font-size: 2.4rem;
    line-height: 1;
}

@media (max-width: 900px) {
    .applications-page .applications-hero {
        padding: 28px 24px 120px;
    }

    .applications-page .applications-hero-total {
        right: 24px;
        bottom: 24px;
    }

    .applications-page .applications-stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 560px) {
    .applications-page .applications-hero {
        padding: 24px 20px 112px;
    }

    .applications-page .applications-hero-total {
        right: 20px;
        bottom: 20px;
        min-width: 140px;
    }

    .applications-page .applications-stats {
        grid-template-columns: 1fr;
        padding: 12px;
    }
}
/* ============================================================
   PART 3 — PROGRESS PANEL AND FILTERS
   ============================================================ */

.applications-page .applications-progress-panel {
    margin-bottom: 24px;
    padding: 22px 26px;
    border: 1px solid rgba(104, 226, 255, 0.22);
    border-radius: 20px;
    background:
        linear-gradient(
            135deg,
            rgba(20, 43, 83, 0.96),
            rgba(28, 39, 92, 0.96)
        );
}

.applications-page .applications-progress-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.applications-page .applications-progress-label {
    display: block;
    color: #5ee7ff;
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.14em;
}

.applications-page .applications-progress-header strong {
    display: block;
    margin-top: 8px;
    color: #f5f8ff;
    font-size: 1rem;
}

.applications-page .applications-progress-percent {
    color: #ffffff;
    font-size: 1.35rem;
    font-weight: 900;
}

.applications-page .applications-progress-track {
    height: 10px;
    margin-top: 18px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
}

.applications-page .applications-progress-fill {
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(
        90deg,
        #5ee7ff,
        #7d6bff
    );
    transition: width 300ms ease;
}

.applications-page .applications-progress-caption {
    display: block;
    margin-top: 10px;
    color: #a5b8d8;
    font-size: 0.78rem;
}

.applications-page .applications-toolbar {
    margin-bottom: 24px;
    padding: 24px;
    border: 1px solid rgba(119, 183, 255, 0.18);
    border-radius: 22px;
    background: rgba(10, 25, 51, 0.94);
}

.applications-page .application-filter-grid {
    display: grid;
    grid-template-columns:
        1.5fr
        1.3fr
        0.8fr
        1fr
        1fr;
    gap: 12px;
}

.applications-page .application-filter-grid label {
    display: block;
}

.applications-page .application-filter-grid label > span {
    display: block;
    margin-bottom: 8px;
    color: #8ea4c8;
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

.applications-page .application-filter-grid input,
.applications-page .application-filter-grid select {
    width: 100%;
    height: 44px;
    padding: 0 12px;
    border: 1px solid rgba(128, 181, 239, 0.24);
    border-radius: 10px;
    outline: none;
    color: #e8f0ff;
    background: #07162e;
}

.applications-page .application-filter-grid input::placeholder {
    color: #6e83a4;
}

.applications-page .application-filter-grid input:focus,
.applications-page .application-filter-grid select:focus {
    border-color: #5ee7ff;
    box-shadow: 0 0 0 3px rgba(94, 231, 255, 0.12);
}

.applications-page .application-filter-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 18px;
}

.applications-page .application-filter-actions button {
    height: 42px;
    padding: 0 18px;
    border: 1px solid rgba(105, 211, 255, 0.38);
    border-radius: 10px;
    color: #07152d;
    background: #5ee7ff;
    font-weight: 800;
}

.applications-page .application-filter-actions button:last-child {
    color: #b8c9e4;
    background: #172844;
}

@media (max-width: 1000px) {
    .applications-page .application-filter-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 560px) {
    .applications-page .applications-progress-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .applications-page .application-filter-grid {
        grid-template-columns: 1fr;
    }

    .applications-page .application-filter-actions {
        justify-content: stretch;
    }

    .applications-page .application-filter-actions button {
        flex: 1;
    }
}
/* ============================================================
   PART 4 — APPLICATIONS TABLE
   ============================================================ */

.applications-page .applications-table-card {
    width: 100%;
    overflow: hidden;
    border: 1px solid rgba(119, 183, 255, 0.2);
    border-radius: 22px;
    background: #0d1b35;
    box-shadow: 0 20px 55px rgba(0, 0, 0, 0.24);
}

.applications-page .applications-table-wrapper {
    width: 100%;
    overflow-x: auto;
}

.applications-page .applications-table {
    width: 100%;
    min-width: 1080px;
    border-collapse: collapse;
    table-layout: fixed;
    color: #dceaff;
}

.applications-page .applications-table thead {
    background: #172b4d;
}

.applications-page .applications-table th {
    height: 56px;
    padding: 10px 6px;
    border-bottom: 1px solid rgba(142, 183, 235, 0.2);
    color: #91a8ca;
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1.15;
    text-align: center;
    text-transform: uppercase;
    vertical-align: middle;
}

.applications-page .applications-table td {
    height: 108px;
    padding: 10px 6px;
    border-top: 1px solid rgba(142, 183, 235, 0.12);
    color: #dceaff;
    font-size: 0.74rem;
    line-height: 1.2;
    text-align: center;
    vertical-align: middle;
}

.applications-page .applications-table tbody tr {
    background: #10213e;
    transition: background 160ms ease;
}

.applications-page .applications-table tbody tr:nth-child(even) {
    background: #132746;
}

.applications-page .applications-table tbody tr:hover {
    background: #1a3760;
}

.applications-page .applications-table th:nth-child(1),
.applications-page .applications-table td:nth-child(1) {
    width: 5%;
}

.applications-page .applications-table th:nth-child(2),
.applications-page .applications-table td:nth-child(2) {
    width: 18%;
}

.applications-page .applications-table th:nth-child(3),
.applications-page .applications-table td:nth-child(3) {
    width: 7%;
}

.applications-page .applications-table th:nth-child(4),
.applications-page .applications-table td:nth-child(4) {
    width: 10%;
}

.applications-page .applications-table th:nth-child(5),
.applications-page .applications-table td:nth-child(5) {
    width: 8%;
}

.applications-page .applications-table th:nth-child(6),
.applications-page .applications-table td:nth-child(6) {
    width: 12%;
}

.applications-page .applications-table th:nth-child(7),
.applications-page .applications-table td:nth-child(7) {
    width: 12%;
}

.applications-page .applications-table th:nth-child(8),
.applications-page .applications-table td:nth-child(8) {
    width: 9%;
}

.applications-page .applications-table th:nth-child(9),
.applications-page .applications-table td:nth-child(9) {
    width: 10%;
}

.applications-page .applications-table th:nth-child(10),
.applications-page .applications-table td:nth-child(10) {
    width: 18%;
}

.applications-page .application-player-name {
    display: block;
    overflow: hidden;
    color: #f4f8ff;
    font-weight: 800;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.applications-page .application-player-email {
    display: block;
    margin-top: 5px;
    overflow: hidden;
    color: #91a8ca;
    font-size: 0.64rem;
    text-overflow: ellipsis;
    white-space: nowrap;
}
/* ============================================================
   PART 5 — BADGES, ACTIONS, FINAL SECTION, RESPONSIVE
   ============================================================ */

.applications-page .application-ai-status-badge,
.applications-page .application-status-badge,
.applications-page .player-response-badge,
.applications-page .application-selection-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 32px;
    padding: 6px 8px;
    border-radius: 999px;
    font-size: 0.62rem;
    font-weight: 900;
    line-height: 1.1;
    text-align: center;
}

.applications-page .application-ai-status-badge {
    color: #8794ff;
    background: rgba(111, 124, 255, 0.15);
    border: 1px solid rgba(111, 124, 255, 0.54);
}

.applications-page .application-status-badge {
    color: #65e6ff;
    background: rgba(101, 230, 255, 0.12);
    border: 1px solid rgba(101, 230, 255, 0.42);
}

.applications-page .player-response-badge.is-accepted {
    color: #8df0bd;
    background: rgba(60, 220, 139, 0.16);
    border: 1px solid rgba(60, 220, 139, 0.72);
}

.applications-page .player-response-badge.is-awaiting {
    color: #ffe082;
    background: rgba(255, 205, 83, 0.16);
    border: 1px solid rgba(255, 205, 83, 0.72);
}

.applications-page .player-response-badge.is-declined {
    color: #ff9ea8;
    background: rgba(255, 93, 112, 0.16);
    border: 1px solid rgba(255, 93, 112, 0.72);
}

.applications-page .application-selection-badge {
    margin-top: 5px;
    color: #8df0d0;
    background: rgba(52, 220, 171, 0.16);
    border: 1px solid rgba(52, 220, 171, 0.72);
}

.applications-page .application-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
    width: 100%;
}

.applications-page .application-actions button {
    width: 100%;
    min-width: 0;
    height: 32px;
    padding: 4px 5px;
    border: 1px solid rgba(130, 181, 239, 0.32);
    border-radius: 9px;
    color: #dceaff;
    background: #1b3153;
    font-size: 0.62rem;
    font-weight: 800;
    white-space: nowrap;
    transition: 160ms ease;
}

.applications-page .application-actions button:hover {
    color: #07152d;
    background: #5ee7ff;
    border-color: #5ee7ff;
    transform: translateY(-1px);
}

.applications-page .application-actions .application-email-button {
    color: #07152d;
    background: #5ee7ff;
    border-color: #5ee7ff;
}

.applications-page .final-confirmed-section {
    margin-bottom: 24px;
    padding: 24px;
    border: 1px solid rgba(94, 231, 255, 0.3);
    border-radius: 22px;
    background:
        linear-gradient(
            135deg,
            #10294a,
            #1b285e
        );
}

.applications-page .final-confirmed-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
}

.applications-page .final-confirmed-header h2 {
    color: #ffffff;
}

.applications-page .final-confirmed-header strong {
    padding: 10px 16px;
    border-radius: 12px;
    color: #07152d;
    background: #5ee7ff;
    font-size: 1.25rem;
}

.applications-page .final-confirmed-list {
    display: grid;
    gap: 8px;
}

.applications-page .final-confirmed-player {
    display: grid;
    grid-template-columns: 1.3fr 1.6fr 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 12px 14px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.09);
    color: #dceaff;
}

.applications-page .final-confirmed-badge {
    padding: 6px 10px;
    border-radius: 999px;
    color: #087443;
    background: #d8f8e8;
    font-size: 0.68rem;
    font-weight: 900;
}

@media (max-width: 900px) {
    .applications-page .applications-table {
        min-width: 980px;
    }

    .applications-page .final-confirmed-player {
        grid-template-columns: 1fr 1fr;
    }
}

@media (max-width: 560px) {
    .applications-page .applications-hero h1 {
        font-size: 2.8rem;
    }

    .applications-page .applications-table {
        min-width: 900px;
    }

    .applications-page .final-confirmed-section {
        padding: 18px;
    }

    .applications-page .final-confirmed-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .applications-page .final-confirmed-player {
        grid-template-columns: 1fr;
    }
}
