:root {
  --bg: #090a0f;
  --surface: rgba(255, 255, 255, 0.03);
  --surface-border: rgba(255, 255, 255, 0.08);
  --primary: #6366f1;
  --primary-glow: rgba(99, 102, 241, 0.35);
  --text-main: #f8fafc;
  --text-muted: #94a3b8;
  --font: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
}

body {
  background-color: var(--bg);
  color: var(--text-main);
  font-family: var(--font);
  min-height: 100vh;
  margin: 0;
  background-image: 
    radial-gradient(at 0% 0%, rgba(99, 102, 241, 0.12) 0px, transparent 50%),
    radial-gradient(at 100% 100%, rgba(168, 85, 247, 0.1) 0px, transparent 50%);
}

.profile-page {
  max-width: 860px;
  margin: 48px auto;
  padding: 0 24px;
}

.profile-page section {
  margin: 28px 0;
  padding: 32px;
  background: var(--surface);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--surface-border);
  border-radius: 20px;
  box-shadow: 
    0 4px 6px -1px rgba(0, 0, 0, 0.1),
    0 24px 38px -12px rgba(0, 0, 0, 0.35);
  transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
}

.profile-page section:hover {
  border-color: rgba(255, 255, 255, 0.14);
  transform: translateY(-2px);
  box-shadow: 
    0 12px 24px -8px rgba(0, 0, 0, 0.4),
    0 0 0 1px rgba(255, 255, 255, 0.05);
}

.profile-page form {
  display: grid;
  gap: 18px;
}

.profile-page input,
.profile-page textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 14px 16px;
  font: inherit;
  font-size: 0.95rem;
  color: var(--text-main);
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 10px;
  outline: none;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.profile-page textarea {
  min-height: 120px;
  resize: vertical;
}

.profile-page input::placeholder,
.profile-page textarea::placeholder {
  color: var(--text-muted);
}

.profile-page input:focus,
.profile-page textarea:focus {
  border-color: var(--primary);
  background: rgba(15, 23, 42, 0.9);
  box-shadow: 0 0 0 4px var(--primary-glow);
}

.profile-page button {
  padding: 14px 28px;
  font: inherit;
  font-size: 0.95rem;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 10px;
  cursor: pointer;
  box-shadow: 0 8px 16px -4px var(--primary-glow);
  transition: all 0.2s ease;
  justify-self: start;
}

.profile-page button:hover {
  background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
  box-shadow: 0 12px 20px -4px rgba(99, 102, 241, 0.5);
  transform: translateY(-1px);
}

.profile-page button:active {
  transform: translateY(0);
  box-shadow: 0 4px 8px -2px var(--primary-glow);
}